{
  "name": "aip-core",
  "version": "2.0.0",
  "description": "AIP - Automotive Intelligence Platform (Unified, Event-Driven, Revenue Core)",
  "main": "dist/app/server.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app/server.ts",
    "build": "tsc",
    "start": "node dist/app/server.js",
    "worker": "node dist/workers/event.worker.js",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/workers/event.worker.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.57.0",
    "p-queue": "^7.3.0",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
