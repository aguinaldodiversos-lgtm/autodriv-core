NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/autodriv
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
CORS_ORIGIN=https://autodriv-frontend.onrender.com
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
RATE_LIMIT_READ_MAX=600
RATE_LIMIT_WRITE_MAX=120

# Billing / Mercado Pago
BILLING_PROVIDER=mercado_pago
BILLING_GRACE_DAYS=5
BILLING_DEFAULT_PLAN_CODE=starter
APP_PUBLIC_URL=https://autodriv-frontend.onrender.com
BILLING_SUCCESS_URL=https://autodriv-frontend.onrender.com/configuracoes?tab=billing
BILLING_FAILURE_URL=https://autodriv-frontend.onrender.com/configuracoes?tab=billing
BILLING_PENDING_URL=https://autodriv-frontend.onrender.com/configuracoes?tab=billing
MERCADO_PAGO_ENV=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_TOLERANCE_MS=300000
MERCADO_PAGO_WEBHOOK_RATE_LIMIT_MAX=120

# Integrações existentes
OPENAI_API_KEY=
OPENAI_LEAD_RECEPTION_MODEL=gpt-4o-mini
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIPE_API_KEY=
CNC_API_URL=
CNC_API_TOKEN=
ZAPI_INSTANCE=
ZAPI_TOKEN=

# WhatsApp AI pre-attendance
WHATSAPP_DEALERSHIP_IDS=
WHATSAPP_AI_ENABLED=true
WHATSAPP_AI_AUTO_REPLY_ENABLED=true
WHATSAPP_AI_HANDOFF_ENABLED=true
WHATSAPP_AI_MAX_AUTO_MESSAGES=5
WHATSAPP_AI_ESCALATION_SCORE=70
WHATSAPP_AI_LOW_CONFIDENCE_THRESHOLD=0.65
WHATSAPP_AI_UNKNOWN_RETRY_LIMIT=1
WHATSAPP_AI_BUSINESS_HOURS_ONLY=false
WHATSAPP_AI_REPLY_DELAY_SECONDS=0
WHATSAPP_AI_HANDOFF_MESSAGE=Perfeito, vou encaminhar voce para um vendedor continuar o atendimento com mais precisao.

# Ad preparation / publication readiness
AD_PREP_MIN_PHOTOS_TO_PUBLISH=4
AD_PREP_IDEAL_PHOTOS_COUNT=10
AD_PREP_MIN_DESCRIPTION_LENGTH=120
AD_PREP_MAX_DESCRIPTION_LENGTH=1200
AD_PREP_MIN_GROSS_MARGIN_PERCENT=5
AD_PREP_MIN_NET_MARGIN_AMOUNT=0
AD_PREP_MAX_PRICE_ABOVE_FIPE_PERCENT=20
AD_PREP_MAX_PRICE_BELOW_FIPE_PERCENT_WITHOUT_REVIEW=35
AD_PREP_FIPE_MAX_AGE_DAYS=45
AD_PREP_REQUIRE_FIPE_TO_PUBLISH=true
AD_PREP_REQUIRE_DOCUMENTATION_CHECK=true
AD_PREP_REQUIRE_PREPARATION_CHECK=true
