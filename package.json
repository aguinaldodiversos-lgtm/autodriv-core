{
  "name": "aip-core",
  "version": "2.0.0",
  "description": "AIP - Automotive Intelligence Platform. API: npm start (Express). Entrada e lista de rotas: docs/ENTRYPOINTS.md e npm run start:info. Rasto TS (app/server.ts) experimental.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:info": "node scripts/print-start-surface.js",
    "brain:scan": "node scripts/scan-brain-usage.js",
    "dev": "node src/server.js",
    "check": "node -e \"console.log('package ok')\"",
    "migrate": "node src/database/migrate.js",
    "migrate:baseline": "node scripts/migrate-baseline.js",
    "check:js": "node scripts/check-js.js",
    "typecheck": "tsc --noEmit",
    "ci:static": "npm run check:js && npm run typecheck",
    "ci": "npm run check:js && npm run typecheck && node scripts/ci-migrate-and-tenant-check.js",
    "verify:env": "node scripts/verify-env.js",
    "start:platform": "node scripts/start-platform-disabled.js",
    "smoke:critical": "node scripts/smoke-critical.js",
    "ai:warmup": "node src/workers/local-ai.worker.js",
    "worker:whatsapp": "node src/workers/whatsapp.worker.js",
    "worker:followup": "node src/workers/followup.worker.js",
    "worker:daily-alert": "node src/workers/daily-alert.worker.js",
    "worker:queue": "node src/workers/queue.worker.js",
    "test": "node scripts/run-tests.js"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.8",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.1",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "openai": "^4.57.0",
    "p-queue": "^8.0.1",
    "pg": "^8.11.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^4.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
