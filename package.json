{
  "name": "aip-core",
  "version": "2.0.0",
  "description": "AIP - Automotive Intelligence Platform. API principal: npm start (Express). npm run start:platform = stack TS experimental (eventos/orquestração), sem paridade 1:1 com todas as rotas Express.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "check": "node -e \"console.log('package ok')\"",
    "typecheck": "tsc --noEmit",
    "ci:static": "npm run typecheck",
    "ci": "npm run typecheck && node scripts/ci-migrate-and-tenant-check.js",
    "verify:env": "node scripts/verify-env.js",
    "start:platform": "tsx src/app/server.ts",
    "smoke:critical": "node scripts/smoke-critical.js",
    "worker:followup": "node src/workers/followup.worker.js",
    "worker:daily-alert": "node src/workers/daily-alert.worker.js",
    "worker:queue": "node src/workers/queue.worker.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.8",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.1",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "hono": "^4.12.14",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "openai": "^4.57.0",
    "p-queue": "^8.0.1",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^4.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
